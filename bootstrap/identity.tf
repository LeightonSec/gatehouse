# Deploy identity and its single GitHub federated credential (D7), plus one
# identity per simulated app (D8). All live in the bootstrap resource group,
# where the deploy identity cannot add federated credentials.

locals {
  # GitHub's immutable subject format (D7). Built here from tfvars, never typed
  # by hand or generated by the portal form.
  github_subject = "repo:${var.github_owner}@${var.github_owner_id}/${var.github_repo}@${var.github_repo_id}:environment:${var.github_environment}"
}

resource "azurerm_user_assigned_identity" "deploy" {
  name                = "id-gatehouse-deploy"
  resource_group_name = azurerm_resource_group.bootstrap.name
  location            = azurerm_resource_group.bootstrap.location
  tags                = var.tags
}

# The only federated credential in the project. A wrong subject fails silently,
# so scripts/verify-bootstrap.sh and scripts/configure-github.sh both check it.
resource "azurerm_federated_identity_credential" "github" {
  name                      = "github-environment-${var.github_environment}"
  user_assigned_identity_id = azurerm_user_assigned_identity.deploy.id
  issuer                    = "https://token.actions.githubusercontent.com"
  audience                  = ["api://AzureADTokenExchange"]
  subject                   = local.github_subject
}

resource "azurerm_user_assigned_identity" "app" {
  for_each = var.app_names

  name                = "id-gatehouse-app-${each.key}"
  resource_group_name = azurerm_resource_group.bootstrap.name
  location            = azurerm_resource_group.bootstrap.location
  tags                = var.tags
}
